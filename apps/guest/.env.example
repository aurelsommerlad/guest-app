# Copy to .env.local for local development. Never commit real values.
# Staging and production values are set in Vercel (per environment, separately).

# Deployment environment: local | staging | production
# (independent of NODE_ENV: staging also runs a production build)
APP_ENV=local

# Public base URL of the guest app (https required for staging/production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: debug | info | warn | error (default: info)
LOG_LEVEL=debug

# --- Added in later phases (do not set yet) -------------------------------
# DATABASE_URL=            # Phase 3 – separate Supabase project per environment
# GUEST_SESSION_SECRET=    # Phase 5 – signing secret for guest session cookies
# APALEO_CLIENT_ID=        # Phase 4 – server only
# APALEO_CLIENT_SECRET=    # Phase 4 – server only
# CREDENTIALS_ENCRYPTION_KEY=  # Phase 4 – encryption of tenant integration credentials
