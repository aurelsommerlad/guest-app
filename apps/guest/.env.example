# Copy to .env.local for local development. Never commit real values.
# Staging and production values are set in Vercel (per environment, separately).

# Deployment environment: local | staging | production
# (independent of NODE_ENV: staging also runs a production build)
APP_ENV=local

# Public base URL of the guest app (https required for staging/production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: debug | info | warn | error (default: info)
LOG_LEVEL=debug

# --- STAY data source --------------------------------------------------------
# mock (default): built-in mock stay, no external calls.
# apaleo: loads APALEO_PREVIEW_RESERVATION_ID from Apaleo (local/staging only –
#         rejected in production until guest access exists).
STAY_DATA_SOURCE=mock

# Apaleo simple client (OAuth 2.0 client credentials, scope: reservations.read).
# Server only. Required when STAY_DATA_SOURCE=apaleo. Never commit real values.
# APALEO_CLIENT_ID=
# APALEO_CLIENT_SECRET=
# Reservation id shown on /stay in apaleo mode (e.g. a reservation in the TEST property).
# APALEO_PREVIEW_RESERVATION_ID=

# --- Database (Phase 6) ------------------------------------------------------
# Server-side Postgres connection – separate Supabase project per environment.
# Optional: the app does not read the database yet. When set, it must be a
# postgres:// URL; outside of local it must not point to localhost.
# Vercel: Supabase *transaction pooler* URL (port 6543). Never NEXT_PUBLIC_.
# Migrations/seed are run explicitly via `pnpm db:migrate` / `pnpm db:seed`
# (see packages/db/README.md) – they do not read this file.
# DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# --- Added in later phases (do not set yet) -------------------------------
# GUEST_SESSION_SECRET=    # signing secret for guest session cookies
