# Copy to .env.local for local development. Never commit real values.
# Staging and production values are set in the Vercel project "admin" (per environment).

# Deployment environment: local | staging | production
APP_ENV=local

# Public base URL of the admin app itself (https required for staging/production)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional: debug | info | warn | error (default: info)
LOG_LEVEL=debug

# Same database as the guest app of this environment. Required at runtime.
# Vercel: Supabase *transaction pooler* URL (port 6543), marked sensitive.
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# --- GUIDE media (Supabase Storage) -----------------------------------------
# Server only. The admin issues path-bound signed upload tokens with this key; the browser
# uploads directly to Storage and never sees the key. Both must be set together; without
# them, image upload is disabled (images can still be removed).
# Never NEXT_PUBLIC_, never in the guest app.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Public bucket (create once in the Supabase dashboard). Default: guide-media
# GUIDE_MEDIA_BUCKET=guide-media

# --- First admin account -----------------------------------------------------
# Enables the one-time /setup page while no admin account exists (min. 32 chars).
# Remove after the first account has been created.
# ADMIN_SETUP_TOKEN=
