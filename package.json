{
  "name": "unique-places-guest-app",
  "private": true,
  "description": "UNIQUE PLACES Guest App \u2013 Guest Experience Platform (Monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && pnpm lint:tokens",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run typecheck lint test build && pnpm lint:tokens",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "db:generate": "pnpm --filter @up/db db:generate",
    "db:migrate": "pnpm --filter @up/db db:migrate",
    "db:seed": "pnpm --filter @up/db db:seed",
    "guest-access:create": "pnpm --filter @up/guest guest-access:create",
    "guest-access:revoke": "pnpm --filter @up/guest guest-access:revoke"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
