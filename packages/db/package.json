{
  "name": "@up/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations and tenant-scoped repositories.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/db.ts migrate",
    "db:seed": "tsx src/cli/db.ts seed"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.5",
    "@up/config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@up/core": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  }
}
